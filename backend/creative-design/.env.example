# ============================================
# 创意设计管线 - 环境变量配置模板
# ============================================
# 复制此文件为 .env 并填入实际值

# --- OpenAI GPT-4o (阶段一：视觉分析) ---
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Meshy API (阶段三：PBR 纹理生成) ---
MESHY_API_KEY=your-meshy-api-key-here

# --- TRELLIS 3D 重建 API (阶段三) ---
TRELLIS_API_URL=http://localhost:7860

# --- SV3D 多视角生成 API (阶段一) ---
SV3D_API_URL=http://localhost:7861

# --- Stable Diffusion Inpainting API (阶段二) ---
INPAINTING_API_URL=http://localhost:7862

# --- 文件存储 ---
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
MAX_FILE_SIZE=52428800
